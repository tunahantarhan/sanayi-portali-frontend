# Frontend ortam değişkenleri
# DİKKAT: VITE_ ile başlayan her değişken herkese açık JavaScript paketine gömülür.
# Buraya hiçbir zaman API anahtarı, şifre veya ERP bilgisi yazılmaz. ERP anahtarı yalnızca backend'de durur.

# false: gerçek backend kullanılır. Boş veya true: mock veriyle demo modu.
VITE_USE_MOCK=true

# Portal backend'inin adresi. Frontend ile aynı sunucudaysa "/api" yeterli.
VITE_API_BASE_URL=/api

# Uygulamanın yayınlandığı yol. GitHub Pages: /sanayi-portali-frontend/  Portal sunucusu: /
VITE_BASE_PATH=/sanayi-portali-frontend/

# Yalnızca geliştirmede: /api isteklerinin yönlendirileceği yerel backend (ör. http://localhost:3000)
API_PROXY_TARGET=
