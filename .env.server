# Portal sunucusu (IIS) için build ayarları: npm run build:server
# Burada gizli bilgi yoktur; VITE_ değişkenleri herkese açık pakete gömülür.

# Backend hazır olana kadar mock veriyle çalışır. Backend kurulunca false yapılır.
VITE_USE_MOCK=true

# Backend aynı sunucuda /api altında olacak (IIS yönlendirmesiyle).
VITE_API_BASE_URL=/api

# Site IIS'te kendi adresinin kökünden sunulur (ör. http://sunucu:8080/).
VITE_BASE_PATH=/
