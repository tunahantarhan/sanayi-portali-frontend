<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS ayarları: index.html her seferinde yeniden kontrol edilir, böylece
     yeni sürüm hemen görünür. assets/ altındaki dosyaların adı her build'de
     değiştiği için uzun süre önbellekte tutulabilir. -->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
